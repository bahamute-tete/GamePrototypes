<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="Root" style="flex-grow: 1; flex-direction: row; height: auto; flex-basis: auto; opacity: 1; -unity-font-style: normal;">
        <ui:VisualElement name="left" style="flex-grow: 1; height: auto; width: 380px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;">
            <uie:ObjectField label="Object Field" style="border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(255, 20, 20); border-right-color: rgb(255, 20, 20); border-top-color: rgb(255, 20, 20); border-bottom-color: rgb(255, 20, 20);" />
            <ui:IntegerField label="Integer Field" value="42" style="border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;" />
            <ui:FloatField label="Float Field" value="42.2" />
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; flex-direction: column; height: auto; scale: 1 1;">
                <ui:Vector3IntField label="Vector3Int" style="flex-direction: row-reverse;" />
                <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="right" style="flex-grow: 1; height: auto; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
            <ui:VisualElement style="flex-grow: 1; height: 10%;">
                <ui:GroupBox style="flex-direction: row; align-items: flex-start; justify-content: flex-start; -unity-text-align: upper-left; white-space: normal; text-overflow: clip; -unity-text-outline-width: 0; word-spacing: 0; -unity-paragraph-spacing: 0; font-size: 10px; align-self: auto; opacity: 1; flex-basis: auto; flex-shrink: 0; flex-grow: 0;">
                    <ui:Label tabindex="-1" text="Label" parse-escape-sequences="true" display-tooltip-when-elided="true" />
                    <ui:Vector3IntField label="Vector3Int" style="width: auto; align-items: center; justify-content: center; align-self: center; flex-direction: column; flex-grow: 1;" />
                    <ui:Button text="Button" parse-escape-sequences="true" display-tooltip-when-elided="true" style="word-spacing: 10px; flex-shrink: 1; flex-grow: 1; -unity-text-align: middle-right;" />
                </ui:GroupBox>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 1; height: 10%;" />
        </ui:VisualElement>
    </ui:VisualElement>
